<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- deliberately NO USE_EXACT_ALARM / SCHEDULE_EXACT_ALARM -->

    <!--
      Android 11+ package visibility: without this, queryIntentActivities returns only a
      handful of visible apps, so the tap-zone app picker looks like a fixed short list.
      Declaring the launcher intent (not QUERY_ALL_PACKAGES) keeps it F-Droid-clean.
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:name=".BinClockApp"
        android:label="@string/app_name"
        android:theme="@style/Theme.BinClockWidget">

        <receiver
            android:name=".widget.BinClockReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="fr.shiningcat.binclockwidget.ACTION_TICK" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/bin_clock_widget_info" />
        </receiver>

        <activity
            android:name=".config.SettingsActivity"
            android:exported="true"
            android:theme="@style/Theme.BinClockWidget">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
            <!-- Launcher entry: opens settings with no widget id (reconfiguration mode). -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

    </application>

</manifest>
