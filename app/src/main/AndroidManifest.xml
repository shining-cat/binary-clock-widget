<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- deliberately NO USE_EXACT_ALARM / SCHEDULE_EXACT_ALARM -->

    <application
        android:name=".BinClockApp"
        android:label="@string/app_name"
        android:theme="@style/Theme.BinClockWidget">

        <receiver
            android:name=".widget.BinClockReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="fr.shiningcat.binclockwidget.ACTION_TICK" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/bin_clock_widget_info" />
        </receiver>

        <activity
            android:name=".config.SettingsActivity"
            android:exported="true"
            android:theme="@style/Theme.BinClockWidget">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

    </application>

</manifest>
