<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- Re-arm the minute tick after a reboot: AlarmManager alarms don't survive one. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!--
      Exact minute ticks so the clock is never a batching-window behind. USE_EXACT_ALARM is the
      sanctioned permission for clock apps (auto-granted, no prompt) on API 33+; SCHEDULE_EXACT_ALARM
      covers 31-32. Paired with a non-wakeup RTC alarm, so the device is never woken just to redraw.
    -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />

    <!--
      Android 11+ package visibility: without this, queryIntentActivities returns only a
      handful of visible apps, so the tap-zone app picker looks like a fixed short list.
      Declaring the launcher intent (not QUERY_ALL_PACKAGES) keeps it F-Droid-clean.
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <!--
          "Open alarms" resolves ACTION_SHOW_ALARMS to an explicit component before firing (an
          implicit action through a widget PendingIntent is silently dropped). Declaring it here
          keeps the resolve working even on devices where the clock app has no launcher entry.
        -->
        <intent>
            <action android:name="android.intent.action.SHOW_ALARMS" />
        </intent>
    </queries>

    <application
        android:name=".BinClockApp"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:theme="@style/Theme.BinClockWidget">

        <receiver
            android:name=".widget.BinClockReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="fr.shiningcat.binclockwidget.ACTION_TICK" />
            </intent-filter>
            <!--
              Signals that either revive a dropped tick chain (reboot, app replacement) or need an
              immediate re-read of state the per-minute tick would otherwise lag behind (time /
              timezone / date change, next-alarm change → the alarm glyph).
            -->
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.DATE_CHANGED" />
                <action android:name="android.app.action.NEXT_ALARM_CLOCK_CHANGED" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/bin_clock_widget_info" />
        </receiver>

        <activity
            android:name=".config.SettingsActivity"
            android:exported="true"
            android:theme="@style/Theme.BinClockWidget">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
            <!-- Launcher entry: opens settings with no widget id (reconfiguration mode). -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

    </application>

</manifest>
