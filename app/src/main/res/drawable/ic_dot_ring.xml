<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <!--
      Fill-based annulus (not a stroke): tints identically to ic_dot_filled via ColorFilter.
      Outer radius 6 == ic_dot_filled radius, so the "off" state is never larger than "on".
      evenOdd carves the inner radius-3 hole.
    -->
    <path
        android:fillColor="#FFFFFFFF"
        android:fillType="evenOdd"
        android:pathData="M12,6 a6,6 0 1,0 0,12 a6,6 0 1,0 0,-12 z M12,9 a3,3 0 1,0 0,6 a3,3 0 1,0 0,-6 z" />
</vector>
